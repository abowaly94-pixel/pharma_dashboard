# Vite Firebase configuration (copy to .env.local and fill with your project values)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Firebase Cloud Messaging VAPID Key (for push notifications)
# Get from: Firebase Console > Project Settings > Cloud Messaging > Web Push certificates
VITE_FIREBASE_VAPID_KEY=

# Supabase Configuration (for image storage)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Remove.bg API (for background removal)
# Get your free API key from: https://www.remove.bg/api
VITE_REMOVEBG_API_KEY=

# Notes:
# - After setting values in .env.local, restart the dev server.
# - Ensure Firestore has collections: medicines, users, pharmacies, orders, notifications.
# - Supabase Storage bucket 'Medicines_images' with folder 'processed_images' should exist.
# - Remove.bg free tier: 50 API calls/month
# - VAPID key is required for Firebase Cloud Messaging push notifications